{
  "manifest_version": 3,
  "name": "RBX Passkey Login",
  "version": "1.0",
  "description": "Auto-login Roblox via imported WebAuthn passkey",
  "permissions": [
    "debugger",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.roblox.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "RBX Passkey"
  }
}
