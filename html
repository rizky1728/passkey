<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<style>
  body{
    width:340px;
    padding:14px;
    font-family:-apple-system,Segoe UI,Roboto,sans-serif;
    background:#0d0d0d;
    color:#eee;
    margin:0;
  }
  h1{font-size:14px;margin:0 0 10px;letter-spacing:1px;font-weight:700;}
  textarea{
    width:100%;
    height:130px;
    background:#050505;
    color:#ddd;
    border:1px solid #252525;
    border-radius:6px;
    padding:8px;
    font-family:monospace;
    font-size:10px;
    resize:vertical;
    box-sizing:border-box;
  }
  .row{display:flex;gap:8px;margin-top:10px;}
  button{
    flex:1;
    border:1px solid #383838;
    background:#1a1a1a;
    color:#eee;
    padding:9px;
    border-radius:6px;
    font-size:11px;
    font-weight:700;
    letter-spacing:1px;
    cursor:pointer;
    transition:.15s;
  }
  button:hover{background:#262626;border-color:#666;}
  button.primary{background:#eee;color:#050505;border-color:#eee;}
  button.primary:hover{background:#fff;}
  .status{
    margin-top:10px;
    padding:8px;
    background:#111;
    border:1px solid #252525;
    border-radius:6px;
    font-size:10px;
    color:#888;
    min-height:14px;
    word-break:break-all;
  }
  .status.ok{color:#7fdc7f;border-color:#1d3d1d;}
  .status.err{color:#e36b6b;border-color:#3d1d1d;}
  label{font-size:10px;color:#666;letter-spacing:1px;}
</style>
</head>
<body>
  <h1>RBX PASSKEY LOGIN</h1>

  <label>PASSKEY JSON</label>
  <textarea id="json" placeholder='{"credentials":[{"credentialId":"...","privateKey":"...","rpId":"roblox.com","userName":"..."}]}'></textarea>

  <div class="row">
    <button onclick="saveJson()">SAVE</button>
    <button onclick="loadJson()">LOAD</button>
  </div>

  <div class="row">
    <button class="primary" onclick="loginNow()">LOGIN NOW →</button>
  </div>

  <div class="row">
    <button onclick="clearAll()">CLEAR</button>
  </div>

  <div id="status" class="status">idle</div>

  <script src="popup.js"></script>
</body>
</html>
